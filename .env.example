# ── MindMesh local-dev (kind + Tilt) configuration ───────────────────────────
# Copy to `.env` and edit; `.env` is gitignored, this file is the committed default
# set. Consumed by scripts/cluster-up.sh, scripts/cluster-down.sh, and the Tiltfile.
# Prod/staging never read this — their secrets come from ExternalSecrets — but the
# variable NAMES match the ExternalSecret keys so the config contract is identical.

# ── Cluster / images ─────────────────────────────────────────────────────────
KIND_CLUSTER_NAME=mindmesh-dev
IMAGE_REGISTRY=mindmesh          # local namespace: ${IMAGE_REGISTRY}/<svc>:${IMAGE_TAG}
IMAGE_TAG=dev

# ── Host Resource controls (read by the Tiltfile + cluster-up.sh) ──────────
# SERVICES: comma/space list of backend services to run; empty = all. The Tiltfile
#   builds/deploys only these; cluster-up.sh starts only the stores they depend on
#   (identity/collection→postgres; scheduler→+redis; sync→+redpanda; search→
#   opensearch+redpanda; analytics→clickhouse+redpanda; media→+minio). identity is
#   usually required (others validate JWTs via its JWKS). Per-invocation override:
#   `tilt up identity collection` (positional args).
SERVICES=
# STORES: override the stores cluster-up.sh starts (comma/space list); empty = derive
#   from SERVICES. e.g. STORES=postgres,redis
STORES=
# TILT_MAX_PARALLEL: how many images Tilt builds at once (default 2; set 1 on ≤12 GB).
TILT_MAX_PARALLEL=2

# Backing-store image versions (kept in sync with docker-compose.yml).
POSTGRES_IMAGE=postgres:18-alpine
REDIS_IMAGE=redis:8-alpine
REDPANDA_IMAGE=redpandadata/redpanda:v24.3.1
OPENSEARCH_IMAGE=opensearchproject/opensearch:3
CLICKHOUSE_IMAGE=clickhouse/clickhouse-server:25.8-alpine
MINIO_IMAGE=minio/minio:RELEASE.2025-04-22T22-12-26Z

# ── Postgres (identity/collection/scheduler/sync share one instance in dev) ──
POSTGRES_USER=mindmesh
POSTGRES_PASSWORD=mindmesh
POSTGRES_DB=mindmesh

# ── ClickHouse (analytics) ───────────────────────────────────────────────────
CLICKHOUSE_USER=mindmesh
CLICKHOUSE_PASSWORD=mindmesh
CLICKHOUSE_DB=mindmesh

# ── MinIO / S3 (media) ───────────────────────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# ── Auth ─────────────────────────────────────────────────────────────────────
# Issuer stamped into locally-signed JWTs (identity signs, others verify via JWKS).
JWT_ISSUER=https://dev.mindmesh.local
JWKS_ISSUER=https://dev.mindmesh.local

# ── Host ports for the Tilt port-forwards (must match web/vite.config.ts proxy) ─
IDENTITY_PORT=8080
COLLECTION_PORT=8081
SCHEDULER_PORT=8082
SYNC_PORT=8083
ANALYTICS_PORT=8084
SEARCH_PORT=8085
MEDIA_PORT=8086
