# Migration runner image: the golang-migrate CLI with every store's SQL baked in
# under /migrations/<store>. Used by the Helm pre-install/pre-upgrade Job.
#
#   docker build -f Dockerfile.migrate -t mindmesh/migrate:dev .
#
# The Job runs, e.g.:
#   migrate -path /migrations/identity -database "$MIGRATE_DATABASE_URL" up
#
# The upstream image bundles the postgres and clickhouse drivers we need and is
# alpine-based (has /bin/sh), so it doubles as a debugging shell if required.
FROM migrate/migrate:v4.18.1

# Baked SQL — one subdirectory per store, matching migrations/<store> in the repo.
COPY migrations/ /migrations/

# Self-healing wrapper around `migrate up`. The Helm Job invokes this instead of
# the raw binary so a dirty-wedged DB can auto-recover in dev (MIGRATE_AUTO_HEAL).
# See scripts/migrate-entrypoint.sh for the rationale.
COPY scripts/migrate-entrypoint.sh /usr/local/bin/migrate-entrypoint.sh
RUN chmod +x /usr/local/bin/migrate-entrypoint.sh
