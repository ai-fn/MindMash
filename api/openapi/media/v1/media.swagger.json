{
  "swagger": "2.0",
  "info": {
    "title": "media/v1/media.proto",
    "version": "version not set"
  },
  "tags": [
    {
      "name": "MediaService",
      "description": "─── Media Service ──────────────────────────────────────────────────────────\n\nUpload, dedupe, delivery and (async) processing of media blobs. Blobs travel\nclient → S3 directly via presigned URLs; this service stays off the data path\nand only records metadata. Every RPC is hard-filtered to the caller's\nuser_id (from the gateway-injected JWT context); tenancy is never\nsupplied by the client. Dedupe (by SHA-256) never crosses users: knowing a\nhash must not grant access to someone else's bytes."
    },
    {
      "name": "MediaInternalService",
      "description": "MediaInternalService is gRPC-only (no REST gateway). It is called by trusted\npeer services — notably Sync, which diffs a client's held checksums against\nthe user's media set to drive media reconciliation."
    }
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "paths": {
    "/v1/media/{mediaId}": {
      "delete": {
        "summary": "Delete unlinks the caller's media row; the underlying blob is garbage\ncollected once no user references its checksum any more.",
        "operationId": "MediaService_Delete",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1DeleteResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "mediaId",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "tags": [
          "MediaService"
        ]
      }
    },
    "/v1/media/{mediaId}:confirm": {
      "post": {
        "summary": "Confirm finalizes an upload: it HEADs the object to verify its size, sha256\nand content type, flips the row to ready, and emits media.uploaded.",
        "operationId": "MediaService_Confirm",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1ConfirmResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "mediaId",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/MediaServiceConfirmBody"
            }
          }
        ],
        "tags": [
          "MediaService"
        ]
      }
    },
    "/v1/media:presign": {
      "post": {
        "summary": "Presign validates the declared mime/size and returns an upload URL bound to\nthe declared bytes, or already_exists=true when this user already stored them.",
        "operationId": "MediaService_Presign",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1PresignResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/v1PresignRequest"
            }
          }
        ],
        "tags": [
          "MediaService"
        ]
      }
    }
  },
  "definitions": {
    "MediaServiceConfirmBody": {
      "type": "object"
    },
    "protobufAny": {
      "type": "object",
      "properties": {
        "@type": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "rpcStatus": {
      "type": "object",
      "properties": {
        "code": {
          "type": "integer",
          "format": "int32"
        },
        "message": {
          "type": "string"
        },
        "details": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/protobufAny"
          }
        }
      }
    },
    "v1ConfirmResponse": {
      "type": "object",
      "properties": {
        "media": {
          "$ref": "#/definitions/v1Media"
        }
      }
    },
    "v1DeleteResponse": {
      "type": "object"
    },
    "v1Media": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "checksum": {
          "type": "string",
          "title": "lowercase hex SHA-256"
        },
        "kind": {
          "type": "string",
          "title": "image | audio | video | latex | other"
        },
        "mime": {
          "type": "string"
        },
        "bytes": {
          "type": "string",
          "format": "int64"
        },
        "status": {
          "type": "string",
          "title": "pending | ready"
        },
        "usn": {
          "type": "string",
          "format": "int64"
        }
      },
      "description": "Media is the metadata for one stored blob owned by the caller."
    },
    "v1PresignRequest": {
      "type": "object",
      "properties": {
        "filename": {
          "type": "string",
          "title": "original client filename (for extension hinting only)"
        },
        "mime": {
          "type": "string",
          "title": "declared content type; validated against the allowlist"
        },
        "sha256": {
          "type": "string",
          "title": "lowercase hex SHA-256 of the bytes, computed by the client"
        },
        "bytes": {
          "type": "string",
          "format": "int64",
          "title": "declared size; validated against the per-kind cap"
        }
      }
    },
    "v1PresignResponse": {
      "type": "object",
      "properties": {
        "mediaId": {
          "type": "string"
        },
        "uploadUrl": {
          "type": "string",
          "title": "empty when already_exists is true"
        },
        "alreadyExists": {
          "type": "boolean",
          "title": "the caller already stored these bytes; skip the PUT"
        },
        "uploadHeaders": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "The PUT must send these verbatim (signed); browsers set Content-Length themselves, so send the body whole."
        }
      }
    }
  }
}
