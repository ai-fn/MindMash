  "definitions": {
    "DeckServiceUpdateDeckBody": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "parentId": {
          "type": "string"
        },
        "configId": {
          "type": "string"
        },
        "expectedUsn": {
          "type": "string",
          "format": "int64"
        }
      },
      "description": "Update replaces the full desired state of the deck (see UpdateNoteTypeRequest);\nchanging parent_id moves the subtree."
    },
    "DeckServiceUpdateDeckConfigBody": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "newPerDay": {
          "type": "integer",
          "format": "int32"
        },
        "revPerDay": {
          "type": "integer",
          "format": "int32"
        },
        "desiredRetention": {
          "type": "number",
          "format": "double"
        },
        "fsrsWeights": {
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          }
        },
        "learningSteps": {
          "type": "array",
          "items": {
            "type": "integer",
            "format": "int32"
          }
        },
        "rolloverHour": {
          "type": "integer",
          "format": "int32"
        },
        "timezone": {
          "type": "string"
        },
        "expectedUsn": {
          "type": "string",
          "format": "int64"
        },
        "maxIntervalDays": {
          "type": "integer",
          "format": "int32",
          "title": "1..36500; 0 means 36500"
        }
      },
      "description": "Update replaces the full desired state of the config (see UpdateNoteTypeRequest)."
    },
    "NoteServiceUpdateNoteBody": {
      "type": "object",
      "properties": {
        "fields": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "flags": {
          "type": "integer",
          "format": "int32"
        },
        "expectedUsn": {
          "type": "string",
          "format": "int64"
        }
      },
      "description": "Update replaces the full desired state of the note (see UpdateNoteTypeRequest)."
    },
    "NoteTypeServiceUpdateNoteTypeBody": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "fields": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1Field"
          }
        },
        "cardTemplates": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1CardTemplate"
          }
        },
        "css": {
          "type": "string"
        },
        "expectedUsn": {
          "type": "string",
          "format": "int64"
        }
      },
      "description": "Update replaces the full desired state of the entity; every mutable field is\nauthoritative (an empty/zero value clears that field). expected_usn guards the\nwrite with optimistic concurrency."
    },
    "protobufAny": {
      "type": "object",
      "properties": {
        "@type": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "rpcStatus": {
      "type": "object",
      "properties": {
        "code": {
          "type": "integer",
          "format": "int32"
        },
        "message": {
          "type": "string"
        },
        "details": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/protobufAny"
          }
        }
      }
    },
    "v1BulkArgs": {
      "type": "object",
      "properties": {
        "targetDeckId": {
          "type": "string",
          "title": "BULK_OP_MOVE"
        },
        "tag": {
          "type": "string",
          "title": "BULK_OP_TAG / BULK_OP_UNTAG"
        },
        "flag": {
          "type": "integer",
          "format": "int32",
          "title": "BULK_OP_FLAG (0 = clear)"
        }
      },
      "description": "BulkArgs — extra parameters for a BulkCards call. Only the field relevant to\nthe request's `op` is read; the rest are ignored. BULK_OP_SUSPEND and\nBULK_OP_DELETE take no args. For BULK_OP_FLAG, flag=0 means \"clear flag\"."
    },
    "v1BulkCardsRequest": {
      "type": "object",
      "properties": {
        "idsList": {
          "$ref": "#/definitions/v1CardIDList"
        },
        "query": {
          "type": "string"
        },
        "op": {
          "$ref": "#/definitions/v1BulkOp"
        },
        "args": {
          "$ref": "#/definitions/v1BulkArgs"
        }
      }
    },
    "v1BulkCardsResponse": {
      "type": "object",
